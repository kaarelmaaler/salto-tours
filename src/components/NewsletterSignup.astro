---
interface Props {
  variant?: "section" | "compact";
}

const { variant = "section" } = Astro.props;
const emailId = `newsletter-email-${variant}`;
const statusId = `newsletter-status-${variant}`;
const hpId = `newsletter-hp-${variant}`;
const headingId = "newsletter-heading";
---

{
  variant === "section" ? (
    <section class="newsletter newsletter-section" aria-labelledby={headingId}>
      <h2 id={headingId}>Tahad Salto järgmiste reisidega kursis olla?</h2>
      <p class="newsletter-copy">
        Liitu uudiskirjaga ja saad uutest reisidest, kohtadest ja registreerimisest teada enne, kui need mujale jõuavad.
      </p>
      <form class="newsletter-form" data-newsletter-form>
        <div class="newsletter-controls">
          <div class="newsletter-row">
            <div class="newsletter-field">
              <label class="visually-hidden" for={emailId}>
                E-post
              </label>
              <input
                id={emailId}
                class="newsletter-input"
                type="email"
                name="email"
                inputmode="email"
                autocomplete="email"
                autocapitalize="none"
                spellcheck="false"
                placeholder="Sinu e-post"
                required
              />
              <p class="newsletter-success" role="status" aria-live="polite"></p>
            </div>
            <button class="newsletter-submit" type="submit">Liitun</button>
          </div>
          <p id={statusId} class="newsletter-status" role="status" aria-live="polite"></p>
        </div>
        <div class="newsletter-hp" aria-hidden="true">
          <label for={hpId}>Website</label>
          <input id={hpId} type="text" name="hp" tabindex="-1" autocomplete="off" />
        </div>
      </form>
    </section>
  ) : (
    <form class="newsletter newsletter-compact" data-newsletter-form aria-label="Uudiskiri">
      <p class="newsletter-copy">Salto uudised otse postkasti.</p>
      <div class="newsletter-controls">
        <div class="newsletter-row">
          <div class="newsletter-field">
            <label class="visually-hidden" for={emailId}>
              E-post
            </label>
            <input
              id={emailId}
              class="newsletter-input"
              type="email"
              name="email"
              inputmode="email"
              autocomplete="email"
              autocapitalize="none"
              spellcheck="false"
              placeholder="Sinu e-post"
              required
            />
            <p class="newsletter-success" role="status" aria-live="polite"></p>
          </div>
          <button class="newsletter-submit" type="submit">Liitun</button>
        </div>
        <p id={statusId} class="newsletter-status" role="status" aria-live="polite"></p>
      </div>
      <div class="newsletter-hp" aria-hidden="true">
        <label for={hpId}>Website</label>
        <input id={hpId} type="text" name="hp" tabindex="-1" autocomplete="off" />
      </div>
    </form>
  )
}

<script>
  const endpoint = "/.netlify/functions/newsletter";
  const successMessage = "Tehtud! Oled nüüd Salto uudiskirjas.";
  const errorMessage = "Midagi läks valesti. Proovi palun uuesti.";

  function showStatus(status: HTMLElement, message: string) {
    status.textContent = message;
    status.classList.add("is-visible");
  }

  function clearStatus(status: HTMLElement) {
    status.textContent = "";
    status.classList.remove("is-visible");
  }

  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const email = form.querySelector<HTMLInputElement>("input[name='email']");
    const hp = form.querySelector<HTMLInputElement>("input[name='hp']");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const status = form.querySelector<HTMLElement>(".newsletter-status");
    const success = form.querySelector<HTMLElement>(".newsletter-success");
    const controls = form.querySelector<HTMLElement>(".newsletter-controls");
    if (!email || !button || !status || !success || !controls) return;

    let pending = false;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (pending || form.classList.contains("is-success")) return;
      pending = true;
      button.disabled = true;
      clearStatus(status);

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            email: email.value,
            hp: hp?.value ?? "",
          }),
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data || data.ok !== true) {
          throw new Error("signup failed");
        }
        const width = Math.round(controls.getBoundingClientRect().width);
        controls.style.width = `${width}px`;
        controls.style.flex = "0 0 auto";
        email.value = "";
        email.disabled = true;
        email.removeAttribute("required");
        success.textContent = successMessage;
        form.classList.add("is-success");
      } catch {
        showStatus(status, errorMessage);
        button.disabled = false;
      } finally {
        pending = false;
      }
    });
  });
</script>
