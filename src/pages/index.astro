---
import TripCard from "../components/TripCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteContent } from "../lib/site-content";
import { getHomepageTrips } from "../lib/trips";

const trips = await getHomepageTrips();
const siteContent = await getSiteContent();
---

<BaseLayout title={`Reisid – ${siteContent.siteTitle}`} current="trips">
  <h1 class="visually-hidden">Reisid</h1>
  {
    trips.length > 0 ? (
      <div class="trip-list">
        {trips.map((trip, index) => (
          <TripCard trip={trip} priority={index === 0} />
        ))}
      </div>
    ) : (
      <article class="card">
        <h1>Reisid</h1>
        <p class="lede">Hetkel avaldatud reise ei ole.</p>
      </article>
    )
  }
</BaseLayout>
