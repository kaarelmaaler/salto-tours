---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  current?: "trips" | "about";
  backgroundImage?: string;
}

const { title, current, backgroundImage } = Astro.props;
---

<!doctype html>
<html lang="et" class="page-trip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="page-trip" style={backgroundImage ? `--trip-bg-image: url("${backgroundImage}")` : undefined}>
    <div class="page-background" aria-hidden="true">
      <div class="background-pattern"></div>
      <div class="background-wordmark">
        <img class="letter letter-s" src="/images/wordmark-s.svg" alt="" width="287.605" height="338" />
        <img class="letter letter-a" src="/images/wordmark-a.svg" alt="" width="304.249" height="322.361" />
        <img class="letter letter-l" src="/images/wordmark-l.svg" alt="" width="245.354" height="322.361" />
        <img class="letter letter-t" src="/images/wordmark-t.svg" alt="" width="311.19" height="322.361" />
        <img class="letter letter-o" src="/images/wordmark-o.svg" alt="" width="335.247" height="337.933" />
      </div>
    </div>

    <Header current={current} />

    <main>
      <slot />
    </main>

    <div class="lightbox" hidden>
      <button type="button" class="lightbox-close" aria-label="Sulge">×</button>
      <img alt="" />
    </div>

    <script>
      import { initGallery } from "../scripts/gallery";
      initGallery();
    </script>
  </body>
</html>
